{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "cloudworks",
    "Audience": "cloudworks-clients",
    "LifetimeMinutes": 60
  },
  "RateLimiting": {
    "LoginAttemptsPerMinute": 5
  },
  "Cors": {
    "AllowedOrigins": []
  }
}
