# Copy to .env (never committed) or set as environment variables.
# ASP.NET Core maps double underscores to configuration sections.
# Locally, prefer `dotnet user-secrets` for the API project.
ConnectionStrings__CloudWorks=Host=localhost;Port=5432;Database=cloudworks;Username=cloudworks_app;Password=CHANGE_ME
Jwt__SigningKey=CHANGE_ME_TO_A_RANDOM_VALUE_OF_AT_LEAST_32_BYTES

# Only needed until the first administrator exists.
Seed__AdministratorUsername=CHANGE_ME
Seed__AdministratorPassword=CHANGE_ME

# Optional. Origins allowed to call the API from a browser.
Cors__AllowedOrigins__0=https://app.example.com

# Integration tests only: a role allowed to CREATE/DROP databases.
CLOUDWORKS_TEST_POSTGRES=Host=localhost;Port=5432;Username=postgres;Password=CHANGE_ME
