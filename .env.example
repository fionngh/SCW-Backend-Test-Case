# Copy to .env (never committed) or set as environment variables.
# ASP.NET Core maps double underscores to configuration sections.
ConnectionStrings__Default=Host=localhost;Port=5432;Database=cloudworks;Username=cloudworks_app;Password=CHANGE_ME
Jwt__SigningKey=CHANGE_ME_TO_A_RANDOM_VALUE_OF_AT_LEAST_32_BYTES
Jwt__Issuer=cloudworks
Jwt__Audience=cloudworks-api

# Integration tests only: a role allowed to CREATE/DROP databases.
CLOUDWORKS_TEST_POSTGRES=Host=localhost;Port=5432;Username=postgres;Password=CHANGE_ME
